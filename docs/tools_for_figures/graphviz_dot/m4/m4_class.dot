digraph G {
rankdir=TB; splines=ortho; nodesep=0.5; ranksep=0.7; splines=true;
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
"ParkingController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;REST, /api/m4&raquo;</i></font><br/><b>ParkingController</b></td></tr><tr><td align="left" balign="left">+registerVehicle / updateVehicle / deactivate / activate<br align="left"/>+hubs(), spaces(hubId), availability(hubId, start, end)<br align="left"/>+book(req), checkIn(id), checkOut(id), cancel(id), myBookings()<br align="left"/>+hubBookings(hubId), block(id), unblock(id)  «Operator»<br align="left"/></td></tr></table>>];
"ParkingService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service&raquo;</i></font><br/><b>ParkingService</b></td></tr><tr><td align="left" balign="left">MIN_BOOKING_MINUTES = 30, MAX_BOOKING_HOURS = 12<br align="left"/>BOOK_AHEAD_HOURS = 24, EARLY_CHECK_IN_MINUTES = 15<br align="left"/>CHECK_OUT_GRACE_MINUTES = 15<br align="left"/></td></tr><tr><td align="left" balign="left">+book(studentId, req: BookParkingRequest): ParkingBookingResponse<br align="left"/>+checkIn(studentId, bookingId) / checkOut(studentId, bookingId)<br align="left"/>+cancel(studentId, bookingId)<br align="left"/>+applyRelease(reservationId, outcome): void<br align="left"/>+handleChargerFailed(pointId) / handleChargerRecovered(pointId)<br align="left"/>+autoCheckOut(bookingId): boolean<br align="left"/>+releaseIfReservationEnded(reservationId): boolean<br align="left"/></td></tr></table>>];
"RentalDockService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service, implements ParkingDock&raquo;</i></font><br/><b>RentalDockService</b></td></tr><tr><td align="left" balign="left">+dockRentalVehicle(vehicleId, hubId): Long<br align="left"/>+undockRentalVehicle(vehicleId): void<br align="left"/>+freeSpacesForRental(hubId): int<br align="left"/>+vacancies(): List&lt;HubVacancy&gt;<br align="left"/></td></tr></table>>];
"ParkingNoShowJob" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;scheduled, every 60 s&raquo;</i></font><br/><b>ParkingNoShowJob</b></td></tr><tr><td align="left" balign="left">+run(): void<br align="left"/></td></tr></table>>];
"ParkingEventHandler" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;event listener, @Order(0)&raquo;</i></font><br/><b>ParkingEventHandler</b></td></tr><tr><td align="left" balign="left">+onReservationExpired / onReservationCancelled<br align="left"/>+onReservationCheckedIn<br align="left"/>+onChargerFailed(e)<br align="left"/>+onResourceStateUpdated(e)  [charger back]<br align="left"/></td></tr></table>>];
"ParkingSpace" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, parking_space&raquo;</i></font><br/><b>ParkingSpace</b></td></tr><tr><td align="left" balign="left">-id, hubId: Long<br align="left"/>-spaceCode: String<br align="left"/>-type: Type {CAR, BIKE}<br align="left"/>-status: Status<br align="left"/>-currentReservationId: Long<br align="left"/>-chargerPointId: Long<br align="left"/>-blockedReason: BlockReason<br align="left"/>-dockedVehicleId: Long<br align="left"/>-version: Long<br align="left"/></td></tr><tr><td align="left" balign="left">+book(reservationId) / checkIn(reservationId)<br align="left"/>+release(reservationId) / detachReservation(reservationId)<br align="left"/>+dock(vehicleId) / undock(vehicleId)<br align="left"/>+block(reason) / unblock()<br align="left"/></td></tr></table>>];
"ParkingBookingLog" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, parking_booking_log&raquo;</i></font><br/><b>ParkingBookingLog</b></td></tr><tr><td align="left" balign="left">-reservationId, spaceId, hubId, studentId<br align="left"/>-vehicleKind, personalVehicleId<br align="left"/>-slotStart, slotEnd, checkInDeadline<br align="left"/>-checkInTime, checkOutTime<br align="left"/>-chargingRequested: boolean<br align="left"/>-status: ACTIVE | COMPLETED | NO_SHOW | CANCELLED<br align="left"/></td></tr><tr><td align="left" balign="left">+open(...) {static}<br align="left"/>+markCheckedIn(now) / close(outcome, now)<br align="left"/></td></tr></table>>];
"PrivateVehicle" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, private_vehicle&raquo;</i></font><br/><b>PrivateVehicle</b></td></tr><tr><td align="left" balign="left">-studentId: Long<br align="left"/>-licensePlate: String<br align="left"/>-type, model, batteryLevel<br align="left"/>-active: boolean<br align="left"/></td></tr><tr><td align="left" balign="left">+register(...) {static}<br align="left"/>+update(...) / deactivate() / activate()<br align="left"/></td></tr></table>>];
"ParkingSpace.Status" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>ParkingSpace.Status</b></td></tr><tr><td align="left" balign="left">FREE<br align="left"/>RESERVED<br align="left"/>OCCUPIED<br align="left"/>BLOCKED<br align="left"/></td></tr><tr><td align="left" balign="left">+canMoveTo(target): boolean<br align="left"/></td></tr></table>>];
"ReservationCore" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;interface (owner M2)&raquo;</i></font><br/><b>ReservationCore</b></td></tr><tr><td align="left" balign="left">+reserveWindow(...)<br align="left"/>+checkIn(...) / cancel(...) / completeByResource(...)<br align="left"/>+cancelForBlockedResource(...)<br align="left"/></td></tr></table>>];
"ParkingDock" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;interface, shared contract&raquo;</i></font><br/><b>ParkingDock</b></td></tr><tr><td align="left" balign="left">used by M3 and M7<br align="left"/></td></tr></table>>];
"EventPublisher" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;shared&raquo;</i></font><br/><b>EventPublisher</b></td></tr><tr><td align="left" balign="left">ResourceStateUpdated (PARKING_SPACE)<br align="left"/>ChargingRequested (M5)<br align="left"/></td></tr></table>>];
"ParkingController" -> "ParkingService" [arrowhead=vee, xlabel="" ];
"ParkingNoShowJob" -> "ParkingService" [arrowhead=vee, xlabel="" ];
"ParkingEventHandler" -> "ParkingService" [arrowhead=vee, xlabel="" ];
"ParkingService" -> "ReservationCore" [arrowhead=vee, xlabel="reserve / check in / cancel" ];
"ParkingService" -> "ParkingSpace" [arrowhead=vee, xlabel="locks" ];
"ParkingService" -> "ParkingBookingLog" [arrowhead=vee, xlabel="" ];
"ParkingService" -> "PrivateVehicle" [arrowhead=vee, xlabel="" ];
"RentalDockService" -> "ParkingDock" [style=dashed, arrowhead=onormal, xlabel="" ];
"RentalDockService" -> "ParkingSpace" [arrowhead=vee, xlabel="dock" ];
"ParkingService" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="publishes" ];
"RentalDockService" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="" ];
"ParkingBookingLog" -> "ParkingSpace" [arrowhead=vee, xlabel="0..* → 1" ];
"ParkingSpace" -> "ParkingSpace.Status" [arrowhead=vee, xlabel="1" ];
"ParkingBookingLog" -> "PrivateVehicle" [arrowhead=vee, xlabel="0..* → 0..1" ];
}