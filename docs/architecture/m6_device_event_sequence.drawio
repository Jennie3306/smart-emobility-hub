        <UserObject label="DeviceReading.eventId is inbound idempotency key.&#10;Each outbound DomainEvent gets a distinct eventId." mermaidId="n:note8" mermaidBaseStyle="html=1;fillColor=light-dark(#fff5ad,#2a2a2a);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="DeviceReading.eventId is inbound idempotency key.&#10;Each outbound DomainEvent gets a distinct eventId." id="133">
