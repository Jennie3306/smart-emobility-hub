digraph E { graph [rankdir=LR, fontname="DejaVu Sans", nodesep=0.25, ranksep=0.9, splines=true, concentrate=false]; node [fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555", arrowhead=teetee, arrowtail=crowodot, dir=both];
