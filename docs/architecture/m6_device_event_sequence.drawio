        <UserObject label="Proposed atomic writes: inbound dedupe mark + ChargingPoint state + Incident when applicable." mermaidId="n:note6" mermaidBaseStyle="html=1;fillColor=light-dark(#fff5ad,#2a2a2a);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Proposed atomic writes: inbound dedupe mark + ChargingPoint state + Incident when applicable." id="131">
