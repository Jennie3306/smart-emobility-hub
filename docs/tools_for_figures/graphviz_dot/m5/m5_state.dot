digraph G {
rankdir=TB; nodesep=0.6; ranksep=0.9; fontname="DejaVu Sans Bold";
node [shape=box, style="rounded,filled", fillcolor="#dae7f8", color="#4a6fa5", fontname="DejaVu Sans Bold", fontsize=15, margin="0.2,0.1"];
edge [fontname="DejaVu Sans", fontsize=13, color="#444444"];
label=<<b>ChargingSession lifecycle — Module M5</b>>; labelloc=t; fontsize=18; ranksep=0.9; nodesep=1.0;
__init [shape=circle, style=filled, fillcolor=black, label="", width=0.22];
__init -> "REQUESTED";
"REQUESTED" [];
"QUEUED" [];
"SCHEDULED" [];
"CHARGING" [fillcolor="#e1f3e8", color="#3a7d44"];
"INTERRUPTED" [fillcolor="#fff1c9", color="#c9a227"];
"COMPLETED" [fillcolor="#e8e8e8", color="#999999"];
"CANCELLED" [fillcolor="#e8e8e8", color="#999999"];
__fin0 [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.15];
"COMPLETED" -> __fin0;
__fin1 [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.15];
"CANCELLED" -> __fin1;
"REQUESTED" -> "QUEUED" [label="enqueue [no free point]" ];
"REQUESTED" -> "SCHEDULED" [label="assign [point free] or\nbooked window inside a parking booking" ];
"QUEUED" -> "SCHEDULED" [label="allocation [highest P,\nURGENT first] / hold 10 min" ];
"SCHEDULED" -> "CHARGING" [label="start [within the hold\nor the booked window]" ];
"SCHEDULED" -> "QUEUED" [label="hold expires\n[automatic low-battery session]" style=dashed];
"CHARGING" -> "COMPLETED" [label="Timer [SoC ≥ 90% or 90 min\nor the window ends]" ];
"SCHEDULED" -> "INTERRUPTED" [label="ChargerFailed\n/ release the point" ];
"CHARGING" -> "INTERRUPTED" [label="ChargerFailed\n/ save SoC" ];
"INTERRUPTED" -> "SCHEDULED" [label="another point free\nin the same hub" ];
"INTERRUPTED" -> "QUEUED" [label="no replacement / keep waitingSince,\n+20 priority" ];
"REQUESTED" -> "CANCELLED" [label="cancel" ];
"QUEUED" -> "CANCELLED" [label="cancel" ];
"SCHEDULED" -> "CANCELLED" [label="cancel, or hold expires\n[student session]" ];
"INTERRUPTED" -> "CANCELLED" [label="cancel" ];
note [shape=note, style=filled, fillcolor="#fff6d5", color="#c9a227", fontname="DejaVu Sans", fontsize=11, label="CHARGING cannot be cancelled: the Timer ends it.\nQUEUED never jumps to CHARGING: a vehicle charges\nonly on the point assigned to it."];
note -> CHARGING [style=dashed, arrowhead=none, color="#c9a227"];
}