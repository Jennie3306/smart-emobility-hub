digraph G {
imagepath="../../python"; rankdir=LR; splines=true; nodesep=0.35; ranksep=1.3; fontname="DejaVu Sans";
node [fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
"stu" [shape=plain, label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td fixedsize="true" width="40" height="56"><img src="stick.png" scale="true"/></td></tr><tr><td><font point-size="12"><b>Student</b></font></td></tr></table>>];
"op" [shape=plain, label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td fixedsize="true" width="40" height="56"><img src="stick.png" scale="true"/></td></tr><tr><td><font point-size="12"><b>Operator</b></font></td></tr></table>>];
subgraph cluster_sys { label=<<b>«subsystem» M5 — Charging and Priority</b>>; fontsize=14; style="rounded"; color="#1f4e79"; penwidth=2; bgcolor="#f9fbfd";
"UC-M5-01" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M5-01</b><br/>Request charging>];
"UC-M5-02" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M5-02</b><br/>Schedule charging>];
"UC-M5-04" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M5-04</b><br/>Cancel a request<br/>or schedule>];
"UC-M5-05" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M5-05</b><br/>View queue<br/>and schedules>];
"UC-M5-03" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M5-03</b><br/>Adjust priority<br/>or schedule>];
"UC-M5-06" [shape=ellipse, style=filled, fillcolor="#fff1c9", color="#d4b04a", penwidth=1.6, fontsize=11, label=<<b>UC-M5-06</b><br/>Rank the queue<br/>and assign ports>];
"UC-M5-07" [shape=ellipse, style=filled, fillcolor="#fff1c9", color="#d4b04a", penwidth=1.6, fontsize=11, label=<<b>UC-M5-07</b><br/>Reassign after<br/>a charger failure>];
"UC-M5-08" [shape=ellipse, style=filled, fillcolor="#fff1c9", color="#d4b04a", penwidth=1.6, fontsize=11, label=<<b>UC-M5-08</b><br/>Finish or expire<br/>a session>];
}
"tim" [shape=plain, label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td fixedsize="true" width="40" height="56"><img src="stick.png" scale="true"/></td></tr><tr><td><font point-size="12"><i>«system»</i><br/><b>Timer (60 s)</b></font></td></tr></table>>];
"iot" [shape=plain, label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td fixedsize="true" width="40" height="56"><img src="stick.png" scale="true"/></td></tr><tr><td><font point-size="12"><i>«system»</i><br/><b>M6 / owner events</b></font></td></tr></table>>];
"stu" -> "UC-M5-01" [dir=none, color="#444444"];
"stu" -> "UC-M5-02" [dir=none, color="#444444"];
"stu" -> "UC-M5-04" [dir=none, color="#444444"];
"stu" -> "UC-M5-05" [dir=none, color="#444444"];
"op" -> "UC-M5-05" [dir=none, color="#444444"];
"op" -> "UC-M5-03" [dir=none, color="#444444"];
"op" -> "UC-M5-01" [dir=none, color="#444444"];
"UC-M5-06" -> "tim" [dir=none, color="#444444"];
"UC-M5-08" -> "tim" [dir=none, color="#444444"];
"UC-M5-07" -> "iot" [dir=none, color="#444444"];
"UC-M5-06" -> "iot" [dir=none, color="#444444"];
"UC-M5-01" -> "UC-M5-06" [style=dashed, color="#2e6fb0", fontcolor="#2e6fb0", label="«include»", constraint=false];
"UC-M5-03" -> "UC-M5-06" [style=dashed, color="#2e6fb0", fontcolor="#2e6fb0", label="«include»", constraint=false];
"UC-M5-07" -> "UC-M5-06" [style=dashed, color="#2e6fb0", fontcolor="#2e6fb0", label="«include»", constraint=false];
"UC-M5-04" -> "UC-M5-05" [style=dashed, color="#c0571b", fontcolor="#c0571b", label="«extend»", constraint=false];
"UC-M5-03" -> "UC-M5-05" [style=dashed, color="#c0571b", fontcolor="#c0571b", label="«extend»", constraint=false];
}