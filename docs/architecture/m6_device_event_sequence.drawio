        <UserObject label="Success path assumes Simulator enabled; resourceType = CHARGING_POINT; ChargingPoint exists; reading reports failure; no active Incident.&#10;Reject, duplicate, and rollback branches are shown separately. Existing-Incident policy remains pending BR-M6-06." mermaidId="n:note0" mermaidBaseStyle="html=1;fillColor=light-dark(#fff5ad,#2a2a2a);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Success path assumes Simulator enabled; resourceType = CHARGING_POINT; ChargingPoint exists; reading reports failure; no active Incident.&#10;Reject, duplicate, and rollback branches are shown separately. Existing-Incident policy remains pending BR-M6-06." id="125">
