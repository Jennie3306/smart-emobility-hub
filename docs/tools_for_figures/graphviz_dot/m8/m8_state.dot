digraph G {
rankdir=LR; nodesep=0.6; ranksep=0.9; fontname="DejaVu Sans Bold";
node [shape=box, style="rounded,filled", fillcolor="#dae7f8", color="#4a6fa5", fontname="DejaVu Sans Bold", fontsize=15, margin="0.2,0.1"];
edge [fontname="DejaVu Sans", fontsize=13, color="#444444"];
label=<<b>Proposal of a what-if run (M8)</b>>; labelloc=t; fontsize=16;
__init [shape=circle, style=filled, fillcolor=black, label="", width=0.22];
__init -> "PENDING";
"PENDING" [];
"NEEDS_REVIEW" [];
"PARTIAL" [];
"APPROVED" [];
"APPLIED" [];
"DISCARDED" [];
"M7decision" [shape=diamond, style=filled, fillcolor="#fff1c9", color="#c9a227", fontsize=12, label="M7\ndecision"];
__fin0 [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.15];
"APPLIED" -> __fin0;
__fin1 [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.15];
"DISCARDED" -> __fin1;
"PENDING" -> "DISCARDED" [label="discard / withdraw the M7 proposal,\nor M7 rejected it" ];
"PENDING" -> "PENDING" [label="apply / M7 could not\ncreate a task yet" ];
"PENDING" -> "PARTIAL" [label="apply / M7 created\nsome tasks" ];
"PENDING" -> "APPROVED" [label="apply / M7 created\nevery task" ];
"PENDING" -> "NEEDS_REVIEW" [label="apply / M7 approval\nnot confirmed" ];
"NEEDS_REVIEW" -> "PENDING" [label="apply / M7 still pending:\nretry the approval" ];
"NEEDS_REVIEW" -> "APPROVED" [label="apply or list runs /\nM7 already approved" ];
"NEEDS_REVIEW" -> "DISCARDED" [label="discard, or M7 rejected" ];
"PARTIAL" -> "PARTIAL" [label="apply again / more tasks" ];
"PARTIAL" -> "APPROVED" [label="apply again /\nremaining tasks created" ];
"APPROVED" -> "APPLIED" [label="list runs / every M7 task finished,\nat least one vehicle arrived" ];
"PENDING" -> "M7decision" [label="list runs (sync): Operator\ndecided directly in M7" ];
"PARTIAL" -> "M7decision" [label="list runs (sync)" ];
"NEEDS_REVIEW" -> "M7decision" [label="list runs (sync)" ];
"M7decision" -> "APPROVED" [label="approved" ];
"M7decision" -> "PARTIAL" [label="partly approved" ];
"M7decision" -> "APPLIED" [label="approved,\ntasks done" ];
"M7decision" -> "DISCARDED" [label="rejected" ];
note [shape=note, style=filled, fillcolor="#fff6d5", color="#c9a227", fontname="DejaVu Sans", fontsize=11, label="Created with the run, always PENDING.\nApply registers it with M7 (propose + approve);\nM8 then follows M7 when runs are listed.\nOnly dispatch proposals can be applied,\nand not on an edited (hypothetical) fleet."];
note -> PENDING [style=dashed, arrowhead=none, color="#c9a227"];
note2 [shape=note, style=filled, fillcolor="#fff6d5", color="#c9a227", fontname="DejaVu Sans", fontsize=11, label="charging_redirect advice is display-only:\nit never goes through Apply and M7 is not called.\nIt stays PENDING until the Operator discards it\n(PENDING -> DISCARDED)."];
note2 -> DISCARDED [style=dashed, arrowhead=none, color="#c9a227"];
}