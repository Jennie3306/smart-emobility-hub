digraph G {
rankdir=TB; splines=ortho; nodesep=0.5; ranksep=0.7; label=<<b>Module M2 — Find and Reserve a Vehicle: class diagram</b>>; labelloc=t; fontsize=16;
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
subgraph "cluster_controller" { label="controller"; fontsize=11; style=dashed; color="#999999";
"VehicleSearchController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;RestController /api/m2&raquo;</i></font><br/><b>VehicleSearchController</b></td></tr><tr><td align="left" balign="left">+search(query): List&lt;VehicleSummary&gt;<br align="left"/>+detail(id): VehicleDetail<br align="left"/>+suggestHubs(query): List&lt;HubSuggestion&gt;<br align="left"/></td></tr></table>>];
"ReservationController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;RestController /api/m2/reservations&raquo;</i></font><br/><b>ReservationController</b></td></tr><tr><td align="left" balign="left">+reserve(request, auth): 201 ReservationResponse<br align="left"/>+current(auth): 200 | 204<br align="left"/>+get(id, auth)<br align="left"/>+cancel(id, auth)<br align="left"/>+checkIn(id, auth)<br align="left"/></td></tr></table>>];
}
subgraph "cluster_service" { label="service"; fontsize=11; style=dashed; color="#999999";
"ReservationCore" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;interface — the only entry point for M4&raquo;</i></font><br/><b>ReservationCore</b></td></tr><tr><td align="left" balign="left">+reserve(userId, type, resourceId, hubId): Reservation<br align="left"/>+reserveWindow(userId, type, resourceId, hubId,<br align="left"/>      startAt, endAt, checkInDeadline): Reservation<br align="left"/>+cancelForBlockedResource(reservationId): Optional<br align="left"/>+cancel(reservationId, requesterId): Reservation<br align="left"/>+checkIn(reservationId, requesterId): Reservation<br align="left"/>+completeByResource(type, resourceId): Optional<br align="left"/>+findActive(userId, type): Optional<br align="left"/></td></tr></table>>];
"ReservationService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;Service&raquo;</i></font><br/><b>ReservationService</b></td></tr><tr><td align="left" balign="left">-repository: ReservationRepository<br align="left"/>-vehicles: VehicleSearchRepository<br align="left"/>-publisher: EventPublisher<br align="left"/>-clock: Clock<br align="left"/>-holdMinutes: int<br align="left"/></td></tr><tr><td align="left" balign="left">+reserveVehicle(userId, vehicleId): Reservation<br align="left"/>+getOwned(reservationId, requesterId)<br align="left"/>+findOverdueIds(): List&lt;Long&gt;<br align="left"/>+expire(reservationId): boolean<br align="left"/>+handleVehicleFailed(vehicleId): Optional<br align="left"/>+pickedUp(vehicleId, userId): void<br align="left"/>-checkCanReserve(userId, type, resourceId)<br align="left"/>-saveActive(r): Reservation  // UNIQUE decides<br align="left"/></td></tr></table>>];
"VehicleSearchService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;Service&raquo;</i></font><br/><b>VehicleSearchService</b></td></tr><tr><td align="left" balign="left">-MAX_SUGGESTIONS = 3<br align="left"/></td></tr><tr><td align="left" balign="left">+search(query): List&lt;VehicleSummary&gt;<br align="left"/>+getDetail(vehicleId): VehicleDetail<br align="left"/>+suggestHubs(query): List&lt;HubSuggestion&gt;<br align="left"/></td></tr></table>>];
"ReservationExpiryJob" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;Component, @Scheduled 30 s&raquo;</i></font><br/><b>ReservationExpiryJob</b></td></tr><tr><td align="left" balign="left">+run(): void<br align="left"/></td></tr></table>>];
}
subgraph "cluster_domain" { label="domain"; fontsize=11; style=dashed; color="#999999";
"Reservation" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, reservation&raquo;</i></font><br/><b>Reservation</b></td></tr><tr><td align="left" balign="left">-id, userId, hubId: Long<br align="left"/>-resourceType: ResourceType<br align="left"/>-resourceId: Long<br align="left"/>-state: ReservationState<br align="left"/>-startAt, endAt, expiresAt: OffsetDateTime<br align="left"/>-checkedInAt, closedAt: OffsetDateTime<br align="left"/>-cancelReason: CancelReason<br align="left"/>-activeResourceKey: String  {UNIQUE}<br align="left"/>-activeUserKey: String  {UNIQUE}<br align="left"/>-version: Long  {@Version}<br align="left"/></td></tr><tr><td align="left" balign="left">+create(...) {static}<br align="left"/>+confirm(now, holdMinutes)<br align="left"/>+confirmWindow(now, start, end, deadline)<br align="left"/>+checkIn(now) / cancel(reason, now)<br align="left"/>+expire(now) / complete(now)<br align="left"/>+reassignResource(newResourceId)<br align="left"/>+isOverdue(now) / remainingSeconds(now)<br align="left"/></td></tr></table>>];
"ReservationState" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>ReservationState</b></td></tr><tr><td align="left" balign="left">PENDING, CONFIRMED, CHECKED_IN<br align="left"/>COMPLETED, CANCELLED, EXPIRED<br align="left"/></td></tr><tr><td align="left" balign="left">+canMoveTo(target): boolean<br align="left"/>+isActive(): boolean<br align="left"/></td></tr></table>>];
"ResourceType" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>ResourceType</b></td></tr><tr><td align="left" balign="left">VEHICLE, PARKING_SPACE<br align="left"/></td></tr></table>>];
"CancelReason" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>CancelReason</b></td></tr><tr><td align="left" balign="left">USER_REQUEST, VEHICLE_FAILED<br align="left"/>RESOURCE_BLOCKED, REJECTED_CONFLICT<br align="left"/></td></tr></table>>];
}
"ReservationEventHandler" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;Component&raquo;</i></font><br/><b>ReservationEventHandler</b></td></tr><tr><td align="left" balign="left">+onVehicleFailed(VehicleFailedEvent)  // after commit<br align="left"/>+onVehicleReturned(VehicleReturnedEvent)<br align="left"/>+onVehiclePickedUp(VehiclePickedUpEvent)<br align="left"/></td></tr></table>>];
"ReservationRepository" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;JpaRepository&raquo;</i></font><br/><b>ReservationRepository</b></td></tr><tr><td align="left" balign="left">+findFirstByUserIdAndResourceTypeAndStateIn(...)<br align="left"/>+findFirstByResourceTypeAndResourceIdAndStateIn(...)<br align="left"/>+findOverdueIds(now): List&lt;Long&gt;<br align="left"/></td></tr></table>>];
"VehicleSearchRepository" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;Repository, read-only view of M3 data&raquo;</i></font><br/><b>VehicleSearchRepository</b></td></tr><tr><td align="left" balign="left">+findById(id)<br align="left"/>+searchAvailable(hubId, type, minBattery)<br align="left"/>+countAvailableByHub(type, minBattery)<br align="left"/>+findReplacements(hubId, type, excludeId)<br align="left"/></td></tr></table>>];
"EventPublisher" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;shared.events&raquo;</i></font><br/><b>EventPublisher</b></td></tr><tr><td align="left" balign="left">+publish(event)<br align="left"/></td></tr></table>>];
"M4 ParkingService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;module m4parking&raquo;</i></font><br/><b>M4 ParkingService</b></td></tr></table>>];
"VehicleSearchController" -> "VehicleSearchService" [arrowhead=vee, xlabel="" ];
"ReservationController" -> "ReservationService" [arrowhead=vee, xlabel="" ];
"ReservationController" -> "VehicleSearchService" [arrowhead=vee, xlabel="findCode()" ];
"ReservationService" -> "ReservationCore" [style=dashed, arrowhead=onormal, xlabel="" ];
"M4 ParkingService" -> "ReservationCore" [style=dashed, arrowhead=vee, xlabel="«use»" ];
"ReservationExpiryJob" -> "ReservationService" [arrowhead=vee, xlabel="" ];
"ReservationEventHandler" -> "ReservationService" [arrowhead=vee, xlabel="" ];
"VehicleSearchService" -> "VehicleSearchRepository" [arrowhead=vee, xlabel="" ];
"ReservationService" -> "VehicleSearchRepository" [arrowhead=vee, xlabel="" ];
"ReservationService" -> "ReservationRepository" [arrowhead=vee, xlabel="" ];
"ReservationService" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="«publish» Confirmed, CheckedIn,\nCancelled, Expired" ];
"ReservationRepository" -> "Reservation" [style=dashed, arrowhead=vee, xlabel="" ];
"Reservation" -> "ReservationState" [arrowhead=vee, xlabel="" ];
"Reservation" -> "ResourceType" [arrowhead=vee, xlabel="" ];
"Reservation" -> "CancelReason" [arrowhead=vee, xlabel="0..1" ];
}