digraph G {
rankdir=TB; splines=ortho; nodesep=0.5; ranksep=0.7; splines=true;
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
"ChargingController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;REST, /api/m5&raquo;</i></font><br/><b>ChargingController</b></td></tr><tr><td align="left" balign="left">+request(req) / schedule(req)<br align="left"/>+start(id) / cancel(id)<br align="left"/>+mine() / hubs() / queue(hubId)  «Operator»<br align="left"/>+changePriority(id, req) / moveSchedule(id, req) / audit(id)  «Operator»<br align="left"/></td></tr></table>>];
"ChargingService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service&raquo;</i></font><br/><b>ChargingService</b></td></tr><tr><td align="left" balign="left">-lowBatteryThreshold: int = 20<br align="left"/></td></tr><tr><td align="left" balign="left">+request(userId, req): ChargingSessionResponse<br align="left"/>+schedule(userId, req): ChargingSessionResponse<br align="left"/>+start / cancel(sessionId, userId, operator)<br align="left"/>+changePriority(sessionId, operatorId, level, reason)<br align="left"/>+runScheduledTasks(): void<br align="left"/>+handleChargerFailed(pointId, hubId): void<br align="left"/>+handleVehicleReturned / handleVehicleLowBattery<br align="left"/>+handleM4ChargingRequest(...): boolean<br align="left"/>+applyRecommendation(id, actionType): void<br align="left"/>-recalculateHub(hubId, now): void<br align="left"/>-expirePortHolds(now) / progressCharging(now)<br align="left"/></td></tr></table>>];
"ChargingPriorityPolicy" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;utility&raquo;</i></font><br/><b>ChargingPriorityPolicy</b></td></tr><tr><td align="left" balign="left">+calculateScore(battery, expectedUse, waitingSince, bonus, level, now): double<br align="left"/>+comparator(): Comparator&lt;ChargingSession&gt;<br align="left"/></td></tr></table>>];
"ChargingScheduler" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;scheduled, every 60 s&raquo;</i></font><br/><b>ChargingScheduler</b></td></tr><tr><td align="left" balign="left">+run(): void<br align="left"/></td></tr></table>>];
"ChargingEventHandler" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;event listener&raquo;</i></font><br/><b>ChargingEventHandler</b></td></tr><tr><td align="left" balign="left">+onChargerFailed / onDeviceReadingReported<br align="left"/>+onVehicleReturned / onVehicleLowBattery<br align="left"/>+onChargingRequested (M4)<br align="left"/>+onReservationCancelled / onReservationExpired<br align="left"/>+onRecommendationApproved<br align="left"/></td></tr></table>>];
"ChargingSession" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, charging_session&raquo;</i></font><br/><b>ChargingSession</b></td></tr><tr><td align="left" balign="left">-userId, hubId, parkingSpaceId: Long<br align="left"/>-vehicleKind: VehicleKind, vehicleId: Long<br align="left"/>-batteryLevel, startBatteryLevel: int<br align="left"/>-status: ChargingSessionStatus<br align="left"/>-priorityLevel: PriorityLevel<br align="left"/>-priorityScore: double, failureBonus: int<br align="left"/>-chargingPointId: Long<br align="left"/>-scheduledStartAt, scheduledEndAt, holdExpiresAt<br align="left"/>-waitingSince, chargingStartedAt, completedAt<br align="left"/>-activeVehicleKey: String (UNIQUE)<br align="left"/></td></tr><tr><td align="left" balign="left">+request(...) / schedule(...) {static}<br align="left"/>+enqueue / assign / start / complete<br align="left"/>+interrupt / requeueAfterFailure / applyFailureBonus<br align="left"/>+cancel / returnToQueue / changePriority<br align="left"/></td></tr></table>>];
"ChargingPoint" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, charging_point&raquo;</i></font><br/><b>ChargingPoint</b></td></tr><tr><td align="left" balign="left">-id, hubId: Long<br align="left"/>-state: ChargingPointState<br align="left"/>-version: Long<br align="left"/></td></tr><tr><td align="left" balign="left">+reserve / startCharging / release<br align="left"/>+markFaulty / recover()<br align="left"/>+applyExternalState(value): boolean<br align="left"/></td></tr></table>>];
"ChargingPriorityAudit" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity&raquo;</i></font><br/><b>ChargingPriorityAudit</b></td></tr><tr><td align="left" balign="left">-sessionId, operatorUserId<br align="left"/>-oldPriority, newPriority, reason<br align="left"/>-changedAt, changeType<br align="left"/></td></tr></table>>];
"ChargingSessionStatus" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>ChargingSessionStatus</b></td></tr><tr><td align="left" balign="left">REQUESTED, QUEUED, SCHEDULED,<br align="left"/>CHARGING, INTERRUPTED,<br align="left"/>COMPLETED, CANCELLED<br align="left"/></td></tr></table>>];
"ChargingPointState" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>ChargingPointState</b></td></tr><tr><td align="left" balign="left">AVAILABLE, RESERVED, IN_USE,<br align="left"/>FAULTY, UNDER_REPAIR<br align="left"/></td></tr></table>>];
"EventPublisher" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;shared&raquo;</i></font><br/><b>EventPublisher</b></td></tr><tr><td align="left" balign="left">ResourceStateUpdated (CHARGING_POINT)<br align="left"/>ChargingStarted / ChargingCompleted<br align="left"/></td></tr></table>>];
"ChargingController" -> "ChargingService" [arrowhead=vee, xlabel="" ];
"ChargingScheduler" -> "ChargingService" [arrowhead=vee, xlabel="" ];
"ChargingEventHandler" -> "ChargingService" [arrowhead=vee, xlabel="" ];
"ChargingService" -> "ChargingPriorityPolicy" [style=dashed, arrowhead=vee, xlabel="ranks with" ];
"ChargingService" -> "ChargingSession" [arrowhead=vee, xlabel="manages" ];
"ChargingService" -> "ChargingPoint" [arrowhead=vee, xlabel="assigns" ];
"ChargingService" -> "ChargingPriorityAudit" [arrowhead=vee, xlabel="records" ];
"ChargingService" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="publishes" ];
"ChargingSession" -> "ChargingPoint" [arrowhead=vee, xlabel="0..* → 0..1" ];
"ChargingSession" -> "ChargingSessionStatus" [arrowhead=vee, xlabel="" ];
"ChargingPoint" -> "ChargingPointState" [arrowhead=vee, xlabel="" ];
"ChargingPriorityAudit" -> "ChargingSession" [arrowhead=vee, xlabel="0..* → 1" ];
}