digraph G {
imagepath="../../python"; rankdir=LR; splines=true; nodesep=0.35; ranksep=1.3; fontname="DejaVu Sans";
node [fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
"stu" [shape=plain, label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td fixedsize="true" width="40" height="56"><img src="stick.png" scale="true"/></td></tr><tr><td><font point-size="12"><b>Student</b></font></td></tr></table>>];
subgraph cluster_sys { label=<<b>«subsystem» M3 — Rental Vehicle Lifecycle</b>>; fontsize=14; style="rounded"; color="#1f4e79"; penwidth=2; bgcolor="#f9fbfd";
"UC-M3-01" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M3-01</b><br/>Pick up a vehicle>];
"UC-M3-04" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M3-04</b><br/>Validate vehicle state<br/>and reservation>];
"UC-M3-02" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M3-02</b><br/>Return a vehicle>];
"UC-M3-05" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M3-05</b><br/>Handle a full hub>];
"UC-M3-03" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M3-03</b><br/>View current trip>];
"UC-M3-06" [shape=ellipse, style=filled, fillcolor="#fff1c9", color="#d4b04a", penwidth=1.6, fontsize=11, label=<<b>UC-M3-06</b><br/>Mark low battery<br/>from a reading>];
}
"iot" [shape=plain, label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td fixedsize="true" width="40" height="56"><img src="stick.png" scale="true"/></td></tr><tr><td><font point-size="12"><i>«system»</i><br/><b>IoT simulator (M6)</b></font></td></tr></table>>];
"stu" -> "UC-M3-01" [dir=none, color="#444444"];
"stu" -> "UC-M3-02" [dir=none, color="#444444"];
"stu" -> "UC-M3-03" [dir=none, color="#444444"];
"UC-M3-06" -> "iot" [dir=none, color="#444444"];
"UC-M3-01" -> "UC-M3-04" [style=dashed, color="#2e6fb0", fontcolor="#2e6fb0", label="«include»", constraint=false];
"UC-M3-05" -> "UC-M3-02" [style=dashed, color="#c0571b", fontcolor="#c0571b", label="«extend»", constraint=false];
}