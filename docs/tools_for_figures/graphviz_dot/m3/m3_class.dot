digraph G {
rankdir=TB; splines=ortho; nodesep=0.5; ranksep=0.7; splines=true;
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
"VehicleController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;REST, /api/m3/vehicles&raquo;</i></font><br/><b>VehicleController</b></td></tr><tr><td align="left" balign="left">+list(): List&lt;VehicleResponse&gt;<br align="left"/>+currentTrip(p: Principal): CurrentTripResponse<br align="left"/>+pickUp(id: Long, p: Principal): void<br align="left"/>+returnVehicle(id: Long, req: ReturnVehicleRequest, p: Principal): void<br align="left"/></td></tr></table>>];
"VehicleService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service&raquo;</i></font><br/><b>VehicleService</b></td></tr><tr><td align="left" balign="left">-lowBatteryThreshold: int = 20<br align="left"/></td></tr><tr><td align="left" balign="left">+pickUp(vehicleId: Long, userId: Long): void<br align="left"/>+returnVehicle(vehicleId: Long, hubId: Long, batteryLevel: int, userId: Long): void<br align="left"/>+getCurrentTrip(userId: Long): CurrentTripResponse<br align="left"/>-alternativeHubs(fullHubId: Long): String<br align="left"/></td></tr></table>>];
"VehicleEventHandler" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;event listener, @Order(0)&raquo;</i></font><br/><b>VehicleEventHandler</b></td></tr><tr><td align="left" balign="left">+onDeviceReadingReported(e): void<br align="left"/>+onVehicleFailed(e): void<br align="left"/>+onChargingStarted(e) / onChargingCompleted(e): void<br align="left"/>+onDispatchStarted(e) / onDispatchCompleted(e) / onDispatchFailed(e): void<br align="left"/>+onReservationExpired(e): void<br align="left"/></td></tr></table>>];
"ReservationVehicleHandler" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;event listener&raquo;</i></font><br/><b>ReservationVehicleHandler</b></td></tr><tr><td align="left" balign="left">+confirmed(e: ReservationConfirmedEvent): void<br align="left"/>+checkedIn(e: ReservationCheckedInEvent): void<br align="left"/>+cancelled(e: ReservationCancelledEvent): void<br align="left"/></td></tr></table>>];
"RentalVehicle" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, rental_vehicle&raquo;</i></font><br/><b>RentalVehicle</b></td></tr><tr><td align="left" balign="left">-id: Long<br align="left"/>-code: String<br align="left"/>-type: VehicleType<br align="left"/>-batteryLevel: int<br align="left"/>-state: VehicleState<br align="left"/>-currentHubId: Long<br align="left"/>-reservedByUserId: Long<br align="left"/>-version: Long<br align="left"/></td></tr><tr><td align="left" balign="left">+changeState(target: VehicleState): void<br align="left"/>+updateBattery(level: int): void<br align="left"/>+reserve(userId: Long): void<br align="left"/>+clearReservation(): void<br align="left"/></td></tr></table>>];
"RentalSession" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, rental_session&raquo;</i></font><br/><b>RentalSession</b></td></tr><tr><td align="left" balign="left">-id: Long<br align="left"/>-vehicleId: Long<br align="left"/>-userId: Long<br align="left"/>-startTime: LocalDateTime<br align="left"/>-endTime: LocalDateTime<br align="left"/>-status: SessionStatus<br align="left"/></td></tr><tr><td align="left" balign="left">+start(vehicleId, userId): RentalSession {static}<br align="left"/>+complete(): void<br align="left"/></td></tr></table>>];
"VehicleState" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>VehicleState</b></td></tr><tr><td align="left" balign="left">AVAILABLE<br align="left"/>RESERVED<br align="left"/>IN_USE<br align="left"/>LOW_BATTERY<br align="left"/>CHARGING<br align="left"/>MAINTENANCE<br align="left"/>IN_TRANSIT<br align="left"/></td></tr><tr><td align="left" balign="left">+canMoveTo(target): boolean<br align="left"/></td></tr></table>>];
"SessionStatus" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>SessionStatus</b></td></tr><tr><td align="left" balign="left">ACTIVE<br align="left"/>COMPLETED<br align="left"/></td></tr></table>>];
"RentalVehicleRepository" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;JpaRepository&raquo;</i></font><br/><b>RentalVehicleRepository</b></td></tr><tr><td align="left" balign="left">+findById(id): Optional&lt;RentalVehicle&gt;<br align="left"/></td></tr></table>>];
"RentalSessionRepository" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;JpaRepository&raquo;</i></font><br/><b>RentalSessionRepository</b></td></tr><tr><td align="left" balign="left">+findByVehicleIdAndStatus(id, s)<br align="left"/>+findByUserIdAndStatus(id, s)<br align="left"/></td></tr></table>>];
"ParkingDock" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;interface, shared contract (owner M4)&raquo;</i></font><br/><b>ParkingDock</b></td></tr><tr><td align="left" balign="left">+dockRentalVehicle(vehicleId, hubId): Long<br align="left"/>+undockRentalVehicle(vehicleId): void<br align="left"/>+vacancies(): List&lt;HubVacancy&gt;<br align="left"/></td></tr></table>>];
"EventPublisher" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;shared&raquo;</i></font><br/><b>EventPublisher</b></td></tr><tr><td align="left" balign="left">+publish(e: DomainEvent): void<br align="left"/></td></tr></table>>];
"CurrentTripResponse" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;record, DTO&raquo;</i></font><br/><b>CurrentTripResponse</b></td></tr><tr><td align="left" balign="left">sessionId, vehicleId, vehicleCode,<br align="left"/>vehicleState, batteryLevel, hubId,<br align="left"/>startTime<br align="left"/></td></tr></table>>];
"VehicleController" -> "VehicleService" [arrowhead=vee, xlabel="" ];
"ReservationVehicleHandler" -> "VehicleService" [arrowhead=vee, xlabel="pickUp" ];
"VehicleService" -> "RentalVehicleRepository" [arrowhead=vee, xlabel="" ];
"VehicleService" -> "RentalSessionRepository" [arrowhead=vee, xlabel="" ];
"VehicleService" -> "ParkingDock" [arrowhead=vee, xlabel="dock / undock" ];
"VehicleService" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="publishes" ];
"VehicleEventHandler" -> "RentalVehicleRepository" [arrowhead=vee, xlabel="" ];
"VehicleEventHandler" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="" ];
"RentalVehicleRepository" -> "RentalVehicle" [style=dashed, arrowhead=vee, xlabel="" ];
"RentalSessionRepository" -> "RentalSession" [style=dashed, arrowhead=vee, xlabel="" ];
"RentalVehicle" -> "VehicleState" [arrowhead=vee, xlabel="1" ];
"RentalSession" -> "SessionStatus" [arrowhead=vee, xlabel="1" ];
"RentalSession" -> "RentalVehicle" [arrowhead=vee, xlabel="0..* → 1" ];
"VehicleService" -> "CurrentTripResponse" [style=dashed, arrowhead=vee, xlabel="creates" ];
}