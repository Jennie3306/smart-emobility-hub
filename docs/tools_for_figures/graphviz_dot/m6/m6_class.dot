digraph G {
rankdir=TB; splines=ortho; nodesep=0.5; ranksep=0.7; splines=true;
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
"SimulatorController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;REST, /api/m6/simulator&raquo;</i></font><br/><b>SimulatorController</b></td></tr><tr><td align="left" balign="left">+status(): SimulatorStatusView<br align="left"/>+run(scenario, req: RunScenarioRequest): SimulationRunView<br align="left"/></td></tr></table>>];
"IncidentController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;REST, /api/m6/incidents&raquo;</i></font><br/><b>IncidentController</b></td></tr><tr><td align="left" balign="left">+report(req) / list(status, type, severity)<br align="left"/>+get(id) / transition(id, req)<br align="left"/></td></tr></table>>];
"SimulatorScheduler" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;scheduled, if enabled&raquo;</i></font><br/><b>SimulatorScheduler</b></td></tr><tr><td align="left" balign="left">-seed: long<br align="left"/></td></tr><tr><td align="left" balign="left">+scheduledTick(): void<br align="left"/></td></tr></table>>];
"DeviceSimulatorService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service&raquo;</i></font><br/><b>DeviceSimulatorService</b></td></tr><tr><td align="left" balign="left">-running: AtomicBoolean<br align="left"/></td></tr><tr><td align="left" balign="left">+runScenario(scenario, seed): SimulationRunView<br align="left"/>+status(): SimulatorStatusView<br align="left"/></td></tr></table>>];
"SyntheticReadingFactory" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;component&raquo;</i></font><br/><b>SyntheticReadingFactory</b></td></tr><tr><td align="left" balign="left">+createReadings(scenario, seed, runId): List&lt;DeviceReading&gt;<br align="left"/></td></tr></table>>];
"DeviceEventService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service&raquo;</i></font><br/><b>DeviceEventService</b></td></tr><tr><td align="left" balign="left">+processReading(reading, runId): ProcessingResult<br align="left"/>-validate(reading)<br align="left"/>-buildEvents(reading): List&lt;DomainEvent&gt;<br align="left"/></td></tr></table>>];
"IncidentService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service&raquo;</i></font><br/><b>IncidentService</b></td></tr><tr><td align="left" balign="left">ACTIVE = {REPORTED, ASSIGNED, IN_PROGRESS}<br align="left"/></td></tr><tr><td align="left" balign="left">+report(req, reporter): Incident<br align="left"/>+openForDeviceFailure(reading): boolean<br align="left"/>+transition(id, req, actor): Incident<br align="left"/>+get(id) / list(...)<br align="left"/></td></tr></table>>];
"Incident" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, incident&raquo;</i></font><br/><b>Incident</b></td></tr><tr><td align="left" balign="left">-resourceType, resourceId, hubId<br align="left"/>-reason: String, severity: IncidentSeverity<br align="left"/>-status: IncidentStatus, source: IncidentSource<br align="left"/>-reportedBy, assignee, note<br align="left"/>-reportedAt, assignedAt, startedAt,<br align="left"/>  resolvedAt, closedAt<br align="left"/>-version: Long (@Version)<br align="left"/></td></tr><tr><td align="left" balign="left">+apply(action, assignee, note, now): void<br align="left"/></td></tr></table>>];
"IncidentStatus" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>IncidentStatus</b></td></tr><tr><td align="left" balign="left">REPORTED, ASSIGNED, IN_PROGRESS,<br align="left"/>RESOLVED, CLOSED<br align="left"/></td></tr><tr><td align="left" balign="left">+transition(action): IncidentStatus<br align="left"/></td></tr></table>>];
"IncidentSeverity" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c0504d"><tr><td bgcolor="#fde9d9" align="center"><font point-size="10"><i>&laquo;enumeration&raquo;</i></font><br/><b>IncidentSeverity</b></td></tr><tr><td align="left" balign="left">LOW, MEDIUM, HIGH, CRITICAL<br align="left"/></td></tr><tr><td align="left" balign="left">+forDeviceFailure(type, reason) {static}<br align="left"/></td></tr></table>>];
"DemoDeviceCatalog" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;component&raquo;</i></font><br/><b>DemoDeviceCatalog</b></td></tr><tr><td align="left" balign="left">+hubFor(type, id): Optional&lt;Long&gt;<br align="left"/></td></tr></table>>];
"InboundDeviceReadingStore / InMemoryDeviceStateStore" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;in-memory&raquo;</i></font><br/><b>InboundDeviceReadingStore / InMemoryDeviceStateStore</b></td></tr><tr><td align="left" balign="left">+find(eventId) / markCompleted(result)<br align="left"/>+save(snapshot)<br align="left"/></td></tr></table>>];
"EventPublisher" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;shared&raquo;</i></font><br/><b>EventPublisher</b></td></tr><tr><td align="left" balign="left">DeviceReadingReported<br align="left"/>VehicleFailed / ChargerFailed<br align="left"/></td></tr></table>>];
"SimulatorController" -> "DeviceSimulatorService" [arrowhead=vee, xlabel="" ];
"SimulatorScheduler" -> "DeviceSimulatorService" [arrowhead=vee, xlabel="" ];
"DeviceSimulatorService" -> "SyntheticReadingFactory" [arrowhead=vee, xlabel="" ];
"DeviceSimulatorService" -> "DeviceEventService" [arrowhead=vee, xlabel="each reading" ];
"DeviceEventService" -> "DemoDeviceCatalog" [arrowhead=vee, xlabel="validates" ];
"DeviceEventService" -> "InboundDeviceReadingStore / InMemoryDeviceStateStore" [arrowhead=vee, xlabel="" ];
"DeviceEventService" -> "IncidentService" [arrowhead=vee, xlabel="failure" ];
"DeviceEventService" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="publishes" ];
"IncidentController" -> "IncidentService" [arrowhead=vee, xlabel="" ];
"IncidentService" -> "Incident" [arrowhead=vee, xlabel="manages" ];
"IncidentService" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="after commit" ];
"Incident" -> "IncidentStatus" [arrowhead=vee, xlabel="" ];
"Incident" -> "IncidentSeverity" [arrowhead=vee, xlabel="" ];
}