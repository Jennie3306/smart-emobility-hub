digraph G {
imagepath="../../python"; rankdir=LR; splines=true; nodesep=0.35; ranksep=1.3; fontname="DejaVu Sans";
node [fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
"op" [shape=plain, label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td fixedsize="true" width="40" height="56"><img src="stick.png" scale="true"/></td></tr><tr><td><font point-size="12"><b>Operator</b></font></td></tr></table>>];
subgraph cluster_sys { label=<<b>«subsystem» M6 — Incidents and Device Events</b>>; fontsize=14; style="rounded"; color="#1f4e79"; penwidth=2; bgcolor="#f9fbfd";
"UC-M6-01" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M6-01</b><br/>Report a device incident>];
"UC-M6-02" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M6-02</b><br/>Manage the incident<br/>lifecycle>];
"UC-M6-06" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M6-06</b><br/>Run and monitor<br/>the simulator>];
"UC-M6-07" [shape=ellipse, style=filled, fillcolor="#dae7f8", color="#6f8fc4", penwidth=1.6, fontsize=11, label=<<b>UC-M6-07</b><br/>Validate payload<br/>and resource>];
"UC-M6-03" [shape=ellipse, style=filled, fillcolor="#fff1c9", color="#d4b04a", penwidth=1.6, fontsize=11, label=<<b>UC-M6-03</b><br/>Receive and process<br/>device readings>];
"UC-M6-04" [shape=ellipse, style=filled, fillcolor="#fff1c9", color="#d4b04a", penwidth=1.6, fontsize=11, label=<<b>UC-M6-04</b><br/>Run the periodic tick>];
"UC-M6-05" [shape=ellipse, style=filled, fillcolor="#fff1c9", color="#d4b04a", penwidth=1.6, fontsize=11, label=<<b>UC-M6-05</b><br/>Record a failure<br/>and announce it>];
}
"tim" [shape=plain, label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td fixedsize="true" width="40" height="56"><img src="stick.png" scale="true"/></td></tr><tr><td><font point-size="12"><i>«system»</i><br/><b>Scheduler</b></font></td></tr></table>>];
"dev" [shape=plain, label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td fixedsize="true" width="40" height="56"><img src="stick.png" scale="true"/></td></tr><tr><td><font point-size="12"><i>«system»</i><br/><b>Simulator /</b><br/><b>device sensors</b></font></td></tr></table>>];
"op" -> "UC-M6-01" [dir=none, color="#444444"];
"op" -> "UC-M6-02" [dir=none, color="#444444"];
"op" -> "UC-M6-06" [dir=none, color="#444444"];
"UC-M6-04" -> "tim" [dir=none, color="#444444"];
"UC-M6-03" -> "dev" [dir=none, color="#444444"];
"UC-M6-01" -> "UC-M6-07" [style=dashed, color="#2e6fb0", fontcolor="#2e6fb0", label="«include»", constraint=false];
"UC-M6-03" -> "UC-M6-07" [style=dashed, color="#2e6fb0", fontcolor="#2e6fb0", label="«include»", constraint=false];
"UC-M6-04" -> "UC-M6-03" [style=dashed, color="#2e6fb0", fontcolor="#2e6fb0", label="«include»", constraint=false];
"UC-M6-06" -> "UC-M6-03" [style=dashed, color="#2e6fb0", fontcolor="#2e6fb0", label="«include»", constraint=false];
"UC-M6-05" -> "UC-M6-03" [style=dashed, color="#c0571b", fontcolor="#c0571b", label="«extend»", constraint=false];
}