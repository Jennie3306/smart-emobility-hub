digraph G {
graph [rankdir=TB, splines=spline, nodesep=0.35, ranksep=0.6, fontname="Arial", pad=0.2, dpi=200, label=<<b>Module M1 — Hub Monitoring and Operations Dashboard: class diagram</b>>, labelloc=t, fontsize=18];
node [shape=plaintext, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=11, arrowhead=vee, color="#444444"];
"MonitoringController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;REST, /api/m1&raquo;</i></font><br/><b>MonitoringController</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+getHubs(hasVehicle: Boolean,<br align="left"/>      hasFreeSlot: Boolean): List&lt;HubSummaryDto&gt;<br align="left"/>+getHub(hubId: Long): HubDetailDto<br align="left"/>+getDashboard(): DashboardDto<br align="left"/>+getAlertHistory(from: OffsetDateTime,<br align="left"/>      to: OffsetDateTime, hubId: Long): List&lt;AlertDto&gt;<br align="left"/>+acknowledge(alertId: Long,<br align="left"/>      principal: Principal): AlertDto<br align="left"/>+dismiss(alertId: Long,<br align="left"/>      request: DismissRequest): AlertDto<br align="left"/></td></tr></table>>];
"ThresholdEvaluationTask" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="11"><i>&laquo;scheduled, Timer&raquo;</i></font><br/><b>ThresholdEvaluationTask</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+evaluateAll(): void<br align="left"/>-evaluateHub(hub: Hub, counts: HubCounts,<br align="left"/>      availableVehicles: int): void<br align="left"/>-evaluate(hubId: Long, type: AlertType, value: int,<br align="left"/>          breached: boolean, cleared: boolean): void<br align="left"/></td></tr></table>>];
"MonitoringEventHandler" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="11"><i>&laquo;event listener, @Order(100)&raquo;</i></font><br/><b>MonitoringEventHandler</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+onResourceStateUpdated(e: ResourceStateUpdatedEvent): void<br align="left"/>+onReservationConfirmed(e: ReservationConfirmedEvent): void<br align="left"/>+onVehiclePickedUp(e: VehiclePickedUpEvent): void<br align="left"/>+onVehicleReturned(e: VehicleReturnedEvent): void<br align="left"/>+onVehicleFailed(e: VehicleFailedEvent): void<br align="left"/>+onVehicleLowBattery(e: VehicleLowBatteryEvent): void<br align="left"/>+onChargingStarted(e: ChargingStartedEvent): void<br align="left"/>+onChargingCompleted(e: ChargingCompletedEvent): void<br align="left"/>+onDispatchStarted(e: DispatchStartedEvent): void<br align="left"/>+onDispatchCompleted(e: DispatchCompletedEvent): void<br align="left"/>+onDispatchFailed(e: DispatchFailedEvent): void<br align="left"/>+normalise(type: String, state: String): String {static}<br align="left"/></td></tr></table>>];
"MonitoringService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;service&raquo;</i></font><br/><b>MonitoringService</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+computeUtilisation(c: HubCounts): UtilisationDto<br align="left"/>+countsPerHub(): Map&lt;Long, HubCounts&gt;<br align="left"/>+availableVehiclesPerHub(): Map&lt;Long, Integer&gt;<br align="left"/>+getHubSummaries(): List&lt;HubSummaryDto&gt;<br align="left"/>+getHubDetail(hubId: Long): HubDetailDto<br align="left"/>+getDashboard(openAlerts: List&lt;AlertDto&gt;): DashboardDto<br align="left"/>+buildHubStatus(hubId: Long): Optional&lt;HubStatusDto&gt;<br align="left"/></td></tr></table>>];
"AlertService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;service&raquo;</i></font><br/><b>AlertService</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+raiseOrRefresh(hubId: Long, type: AlertType,<br align="left"/>      value: int): Alert<br align="left"/>+clear(alert: Alert): void<br align="left"/>+acknowledge(alertId: Long, username: String): AlertDto<br align="left"/>+dismiss(alertId: Long, reason: String): AlertDto<br align="left"/>+findOpen(): List&lt;AlertDto&gt;<br align="left"/>+findHistory(from: OffsetDateTime, to: OffsetDateTime,<br align="left"/>      hubId: Long): List&lt;AlertDto&gt;<br align="left"/>+toDto(a: Alert): AlertDto<br align="left"/></td></tr></table>>];
"DashboardPublisher" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;STOMP wrapper&raquo;</i></font><br/><b>DashboardPublisher</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+publishHubStatus(dto: HubStatusDto): void<br align="left"/>+publishAlert(dto: AlertDto): void<br align="left"/></td></tr></table>>];
"MonitoringProperties" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;config app.monitoring&raquo;</i></font><br/><b>MonitoringProperties</b></td></tr><tr><td align="left" balign="left">-capacityRaiseThreshold: int = 80<br align="left"/>-capacityClearThreshold: int = 75<br align="left"/>-lowVehicleThreshold: int = 2<br align="left"/>-lowVehicleClearThreshold: int = 4<br align="left"/></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
"AlertRepository" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;interface&raquo;</i></font><br/><b>AlertRepository</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+findOpenByHubAndType(hubId: Long,<br align="left"/>      type: AlertType): Optional&lt;Alert&gt;<br align="left"/>+findOpen(): List&lt;Alert&gt;<br align="left"/>+findByRaisedAtBetweenOrderByRaisedAtDesc(<br align="left"/>     from: OffsetDateTime, to: OffsetDateTime): List&lt;Alert&gt;<br align="left"/>+findByHubIdAndRaisedAtBetweenOrderByRaisedAtDesc(<br align="left"/>     hubId: Long, from: OffsetDateTime, to: OffsetDateTime): List&lt;Alert&gt;<br align="left"/></td></tr></table>>];
"ResourceStateRepository" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;interface&raquo;</i></font><br/><b>ResourceStateRepository</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+countByHub(): List&lt;Object[]&gt;<br align="left"/>+findByResourceTypeAndResourceId(<br align="left"/>     type: String, id: Long): Optional&lt;ResourceState&gt;<br align="left"/>+findOfHub(hubId: Long,<br align="left"/>      type: String): List&lt;ResourceState&gt;<br align="left"/></td></tr></table>>];
"HubRepository" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;interface&raquo;</i></font><br/><b>HubRepository</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+findAllByOrderByIdAsc(): List&lt;Hub&gt;<br align="left"/>+countAvailableVehiclesPerHub(): List&lt;Object[]&gt;<br align="left"/>+findVehiclesOfHub(hubId: Long): List&lt;Object[]&gt;<br align="left"/>+findVehicleCountByState(): List&lt;Object[]&gt;<br align="left"/></td></tr></table>>];
"ProcessedEventStore" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#888888"><tr><td bgcolor="#f0f0f0" align="center"><font point-size="11"><i>&laquo;shared&raquo;</i></font><br/><b>ProcessedEventStore</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+markIfNew(consumer: String, eventId: UUID): boolean<br align="left"/></td></tr></table>>];
"EventPublisher" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#888888"><tr><td bgcolor="#f0f0f0" align="center"><font point-size="11"><i>&laquo;shared&raquo;</i></font><br/><b>EventPublisher</b></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left">+publish(event: DomainEvent): void<br align="left"/></td></tr></table>>];
"Alert" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#3c8a3c"><tr><td bgcolor="#e6f2e6" align="center"><font point-size="11"><i>&laquo;entity, owned by M1&raquo;</i></font><br/><b>Alert</b></td></tr><tr><td align="left" balign="left">-id: Long<br align="left"/>-hubId: Long<br align="left"/>-type: AlertType<br align="left"/>-state: AlertState<br align="left"/>-triggerValue: int<br align="left"/>-raisedAt: OffsetDateTime<br align="left"/>-acknowledgedBy: String<br align="left"/>-acknowledgedAt: OffsetDateTime<br align="left"/>-closedAt: OffsetDateTime<br align="left"/>-dismissReason: String<br align="left"/></td></tr><tr><td align="left" balign="left">+raise(hubId: Long, type: AlertType,<br align="left"/>      value: int): Alert {static}<br align="left"/>+acknowledge(username: String): void<br align="left"/>+dismiss(reason: String): void<br align="left"/>+resolve(): void<br align="left"/>+refresh(latestValue: int): void<br align="left"/></td></tr></table>>];
"ResourceState" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#3c8a3c"><tr><td bgcolor="#e6f2e6" align="center"><font point-size="11"><i>&laquo;entity, read model owned by M1&raquo;</i></font><br/><b>ResourceState</b></td></tr><tr><td align="left" balign="left">-resourceType: String {PK}<br align="left"/>-resourceId: Long {PK}<br align="left"/>-hubId: Long<br align="left"/>-state: String<br align="left"/>-updatedAt: OffsetDateTime<br align="left"/></td></tr><tr><td align="left" balign="left">+applyState(newState: String): void<br align="left"/></td></tr></table>>];
"Hub" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#888888"><tr><td bgcolor="#f0f0f0" align="center"><font point-size="11"><i>&laquo;entity, shared, read only&raquo;</i></font><br/><b>Hub</b></td></tr><tr><td align="left" balign="left">-id: Long<br align="left"/>-name: String<br align="left"/>-location: String<br align="left"/></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
"HubCounts" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;record&raquo;</i></font><br/><b>HubCounts</b></td></tr><tr><td align="left" balign="left">-hubId: long<br align="left"/>-totalSlots, usedSlots, freeSlots: long<br align="left"/>-operationalPoints, pointsInUse, freePoints: long<br align="left"/></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
"AlertState" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;enumeration&raquo;</i></font><br/><b>AlertState</b></td></tr><tr><td align="left" balign="left">OPEN<br align="left"/>ACKNOWLEDGED<br align="left"/>RESOLVED<br align="left"/>DISMISSED<br align="left"/></td></tr><tr><td align="left" balign="left">+isOpen(): boolean<br align="left"/>+canMoveTo(target: AlertState): boolean<br align="left"/></td></tr></table>>];
"AlertType" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="11"><i>&laquo;enumeration&raquo;</i></font><br/><b>AlertType</b></td></tr><tr><td align="left" balign="left">CAPACITY<br align="left"/>LOW_VEHICLE<br align="left"/></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
{rank=same; "MonitoringController"; "ThresholdEvaluationTask"; "MonitoringEventHandler";}
{rank=same; "MonitoringService"; "AlertService"; "DashboardPublisher"; "MonitoringProperties";}
{rank=same; "HubRepository"; "ResourceStateRepository"; "AlertRepository"; "ProcessedEventStore"; "EventPublisher";}
{rank=same; "Hub"; "ResourceState"; "Alert"; "HubCounts";}
"MonitoringController" -> "MonitoringService" 
"MonitoringController" -> "AlertService" 
"ThresholdEvaluationTask" -> "MonitoringService" 
"ThresholdEvaluationTask" -> "AlertService" 
"ThresholdEvaluationTask" -> "MonitoringProperties" 
"ThresholdEvaluationTask" -> "DashboardPublisher" 
"MonitoringEventHandler" -> "MonitoringService" 
"MonitoringEventHandler" -> "ResourceStateRepository" 
"MonitoringEventHandler" -> "ProcessedEventStore" 
"MonitoringEventHandler" -> "DashboardPublisher" 
"AlertService" -> "AlertRepository" 
"AlertService" -> "EventPublisher" [label=" publishes\n HubNearCapacityEvent"]
"AlertService" -> "DashboardPublisher" 
"MonitoringService" -> "HubRepository" 
"MonitoringService" -> "ResourceStateRepository" 
"MonitoringService" -> "HubCounts" [style=dashed, label=" «use»"]
"AlertRepository" -> "Alert" [style=dashed]
"ResourceStateRepository" -> "ResourceState" [style=dashed]
"HubRepository" -> "Hub" [style=dashed]
"Alert" -> "AlertState" 
"Alert" -> "AlertType" 
"Hub" -> "Alert" [dir=none, style=solid, headlabel="0..*", taillabel="1", label=" raised for", constraint=false];
"Hub" -> "ResourceState" [dir=none, headlabel="0..*", taillabel="1", label=" located at", constraint=false];
}