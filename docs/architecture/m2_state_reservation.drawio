<mxfile host="app.diagrams.net">
  <diagram id="m2-state-reservation" name="Reservation state machine">
    <mxGraphModel dx="1888" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;State machine Reservation (M2) — enum ReservationState&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="600" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="s_init" parent="1" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="40" y="205" as="geometry" />
        </mxCell>
        <mxCell id="s_pending" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="PENDING" vertex="1">
          <mxGeometry height="60" width="130" x="200" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s_confirmed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="CONFIRMED" vertex="1">
          <mxGeometry height="60" width="150" x="600" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s_checkedin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="CHECKED_IN" vertex="1">
          <mxGeometry height="60" width="150" x="1040" y="40" as="geometry" />
        </mxCell>
        <mxCell id="s_completed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="COMPLETED" vertex="1">
          <mxGeometry height="60" width="150" x="1380" y="40" as="geometry" />
        </mxCell>
        <mxCell id="s_expired" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="EXPIRED" vertex="1">
          <mxGeometry height="60" width="150" x="1040" y="330" as="geometry" />
        </mxCell>
        <mxCell id="s_cancelled" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="CANCELLED" vertex="1">
          <mxGeometry height="60" width="150" x="600" y="500" as="geometry" />
        </mxCell>
        <mxCell id="s_final" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1440" y="345" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="s_init" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;labelBackgroundColor=#ffffff;fontSize=11;" target="s_pending" value="reserve() / tạo bản ghi">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-18" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="s_pending" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;labelBackgroundColor=#ffffff;fontSize=11;" target="s_confirmed" value="kiểm tra hợp lệ&lt;br&gt;[xe AVAILABLE ∧ chưa có đặt chỗ hiệu lực]&lt;br&gt;/ expiresAt = now + 15 phút,&lt;br&gt;phát ReservationConfirmedEvent">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-40" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="s_pending" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s_cancelled" value="kiểm tra thất bại&lt;br&gt;[xe không AVAILABLE ∨ đã có đặt chỗ hiệu lực&lt;br&gt;∨ vi phạm UNIQUE]&lt;br&gt;/ cancelReason = REJECTED_CONFLICT, trả 409 (rollback)">
          <mxGeometry relative="1" x="-0.4472" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="s_confirmed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s_checkedin" value="checkIn()&lt;br&gt;[chủ đặt chỗ ∧ now &amp;lt; expiresAt]&lt;br&gt;/ checkedInAt = now">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="s_confirmed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s_expired" value="Timer (30 giây)&lt;br&gt;[now ≥ expiresAt]&lt;br&gt;/ nhả khóa, phát&lt;br&gt;ReservationExpiredEvent">
          <mxGeometry relative="1" x="-0.0361" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="s_confirmed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" target="s_cancelled" value="cancel()&lt;br&gt;[chủ đặt chỗ ∧ now &amp;lt; expiresAt]&lt;br&gt;/ cancelReason = USER_REQUEST,&lt;br&gt;nhả khóa, phát&lt;br&gt;ReservationCancelledEvent">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-110" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="s_confirmed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" target="s_cancelled" value="VehicleFailedEvent&lt;br&gt;[không có xe thay thế]&lt;br&gt;/ cancelReason = VEHICLE_FAILED,&lt;br&gt;nhả khóa, phát&lt;br&gt;ReservationCancelledEvent">
          <mxGeometry relative="1" x="0.2" y="105" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="s_confirmed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" target="s_confirmed" value="VehicleFailedEvent [có xe thay thế cùng Hub, cùng loại]&lt;br&gt;/ đổi resourceId và activeResourceKey, giữ expiresAt,&lt;br&gt;phát ReservationConfirmedEvent (xe mới)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-30" as="offset" />
            <Array as="points">
              <mxPoint x="637" y="140" />
              <mxPoint x="712" y="140" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="s_checkedin" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;labelBackgroundColor=#ffffff;fontSize=11;" target="s_completed" value="VehicleReturnedEvent / complete()&lt;br&gt;/ nhả khóa">
          <mxGeometry relative="1" x="-0.0526" y="30" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="f1" edge="1" parent="1" source="s_completed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="s_final" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" edge="1" parent="1" source="s_expired" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s_final" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" edge="1" parent="1" source="s_cancelled" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="s_final" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8fafc;strokeColor=#64748b;" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• &quot;nhả khóa&quot; = activeResourceKey = NULL, activeUserKey = NULL, closedAt = now.&lt;br&gt;• Trạng thái kết thúc: COMPLETED, CANCELLED, EXPIRED — canMoveTo() trả về false.&lt;br&gt;• cancelReason (CancelReason) cho biết lý do vào CANCELLED: USER_REQUEST, VEHICLE_FAILED, REJECTED_CONFLICT.&lt;br&gt;• PENDING → CANCELLED xảy ra trong transaction bị rollback nên không lưu vào CSDL (§4.4)." vertex="1">
          <mxGeometry height="95" width="600" x="40" y="600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
