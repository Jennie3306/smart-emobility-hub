digraph G {
rankdir=TB; splines=ortho; nodesep=0.5; ranksep=0.7; splines=true;
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
"SimulationController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;REST, /api/m8 (OPERATOR)&raquo;</i></font><br/><b>SimulationController</b></td></tr><tr><td align="left" balign="left">+snapshot() / status() / runs()<br align="left"/>+parse(text): ParseResult<br align="left"/>+run(scenario, snapshotRunId, repeatRecentBookings): Run<br align="left"/>+discard(runId, recId) / apply(runId, recId)<br align="left"/>+check()<br align="left"/></td></tr></table>>];
"SimulationService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service&raquo;</i></font><br/><b>SimulationService</b></td></tr><tr><td align="left" balign="left">+run(scenario, snapshotRunId, repeat): Run<br align="left"/>+discard(runId, recId): Run<br align="left"/>+apply(runId, recId)<br align="left"/>+parse(text): ParseResult<br align="left"/></td></tr></table>>];
"ScenarioAssistant" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service, optional LLM (M8_LLM_*)&raquo;</i></font><br/><b>ScenarioAssistant</b></td></tr><tr><td align="left" balign="left">-url, key, model: String<br align="left"/></td></tr><tr><td align="left" balign="left">+parse(text, snapshot): ParseResult<br align="left"/>+validate(scenario, snapshot)<br align="left"/>+recommend(snapshot, scenario, kpi, engine): Proposals<br align="left"/>-parkingRoom(snapshot, hub): int<br align="left"/></td></tr></table>>];
"SimulationEngine" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;component, pure function&raquo;</i></font><br/><b>SimulationEngine</b></td></tr><tr><td align="left" balign="left">+simulate(snapshot, scenario): EngineResult<br align="left"/></td></tr></table>>];
"SnapshotProvider" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;interface&raquo;</i></font><br/><b>SnapshotProvider</b></td></tr><tr><td align="left" balign="left">+capture(): Snapshot<br align="left"/></td></tr></table>>];
"JdbcSnapshotProvider" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;read-only, REPEATABLE_READ&raquo;</i></font><br/><b>JdbcSnapshotProvider</b></td></tr><tr><td align="left" balign="left">-devices: Map&lt;String, DeviceState&gt;<br align="left"/></td></tr><tr><td align="left" balign="left">+capture(): Snapshot<br align="left"/>+onResourceState(e: ResourceStateUpdatedEvent)<br align="left"/></td></tr></table>>];
"RunStore" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;JSON file, latest 200 runs&raquo;</i></font><br/><b>RunStore</b></td></tr><tr><td align="left" balign="left">-file: Path<br align="left"/></td></tr><tr><td align="left" balign="left">+save(run) / get(id) / list()<br align="left"/></td></tr></table>>];
"NetworkMonitor" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;@Scheduled every 30 min&raquo;</i></font><br/><b>NetworkMonitor</b></td></tr><tr><td align="left" balign="left">-state: State (volatile)<br align="left"/></td></tr><tr><td align="left" balign="left">+check()<br align="left"/>+status(aiConfigured): Map<br align="left"/></td></tr></table>>];
"SimulationModels" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;immutable records&raquo;</i></font><br/><b>SimulationModels</b></td></tr><tr><td align="left" balign="left">Scenario(name, hubId, disabled, injectedRequests,<br align="left"/>  durationMins, arrivalWindowMins, tripMins, reroute, seed)<br align="left"/>Snapshot(hubs, vehicles, deviceStates, bookingWindow, capacities)<br align="left"/>Kpi(requests, served, failed, failurePercent, meanWaitMins, peakQueue, hubs)<br align="left"/>Run(scenario, snapshot, kpi, baseline, timeline, recommendations)<br align="left"/>Recommendation(action, from, to, amount, status, projectedFailure%)<br align="left"/></td></tr></table>>];
"hub, rental_vehicle, reservation, m1_resource_state" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;tables of M1–M4 (read only)&raquo;</i></font><br/><b>hub, rental_vehicle, reservation, m1_resource_state</b></td></tr></table>>];
"SimulationController" -> "SimulationService" [arrowhead=vee, xlabel="" ];
"SimulationController" -> "NetworkMonitor" [arrowhead=vee, xlabel="" ];
"SimulationService" -> "SnapshotProvider" [arrowhead=vee, xlabel="" ];
"SimulationService" -> "SimulationEngine" [arrowhead=vee, xlabel="" ];
"SimulationService" -> "RunStore" [arrowhead=vee, xlabel="" ];
"SimulationService" -> "ScenarioAssistant" [arrowhead=vee, xlabel="" ];
"ScenarioAssistant" -> "SimulationEngine" [style=dashed, arrowhead=vee, xlabel="re-simulates proposals" ];
"JdbcSnapshotProvider" -> "SnapshotProvider" [style=dashed, arrowhead=onormal, xlabel="" ];
"JdbcSnapshotProvider" -> "hub, rental_vehicle, reservation, m1_resource_state" [style=dashed, arrowhead=vee, xlabel="SELECT" ];
"NetworkMonitor" -> "SnapshotProvider" [arrowhead=vee, xlabel="" ];
"NetworkMonitor" -> "SimulationEngine" [arrowhead=vee, xlabel="" ];
"RunStore" -> "SimulationModels" [style=dashed, arrowhead=vee, xlabel="" ];
}