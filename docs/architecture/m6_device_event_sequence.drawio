            <mxGeometry height="58" width="1262" x="894" y="2492" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Spring in-process event bus; synchronous listener delivery. M6 does not call consumer services." mermaidId="n:note9" mermaidBaseStyle="html=1;fillColor=light-dark(#fff5ad,#2a2a2a);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Spring in-process event bus; synchronous listener delivery. M6 does not call consumer services." id="134">
