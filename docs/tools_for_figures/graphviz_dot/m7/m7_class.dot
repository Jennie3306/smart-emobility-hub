digraph G {
rankdir=TB; splines=ortho; nodesep=0.5; ranksep=0.7; splines=true;
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
"RedistributionController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;REST, /api/m7/redistributions&raquo;</i></font><br/><b>RedistributionController</b></td></tr><tr><td align="left" balign="left">+create(req) / list(status) / get(id)<br align="left"/>+updateStatus(id, status)<br align="left"/></td></tr></table>>];
"RecommendationController" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;REST, /api/m7/recommendations&raquo;</i></font><br/><b>RecommendationController</b></td></tr><tr><td align="left" balign="left">+list(status) / approve(id) / reject(id, reason)<br align="left"/></td></tr></table>>];
"RedistributionEventHandler" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#c9a227"><tr><td bgcolor="#fff4dc" align="center"><font point-size="10"><i>&laquo;@TransactionalEventListener&raquo;</i></font><br/><b>RedistributionEventHandler</b></td></tr><tr><td align="left" balign="left">+onHubNearCapacity(e: HubNearCapacityEvent)<br align="left"/></td></tr></table>>];
"RecommendationService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service, implements RedistributionRecommendations&raquo;</i></font><br/><b>RecommendationService</b></td></tr><tr><td align="left" balign="left">-keepAtDonor = 4, targetAvailable = 4<br align="left"/>-parkingTargetPercent = 75<br align="left"/></td></tr><tr><td align="left" balign="left">+proposeForAlert(hubId, type, ref): Optional&lt;...&gt;<br align="left"/>+propose(source, ref, from, to, amount, reason): String<br align="left"/>+approve(id, by): ApprovalResult<br align="left"/>+reject(id, by, reason)<br align="left"/>-forShortage / forCrowding<br align="left"/></td></tr></table>>];
"RedistributionService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;service&raquo;</i></font><br/><b>RedistributionService</b></td></tr><tr><td align="left" balign="left">+createRedistributionTask(vehicle, from, to): RedistributionTask<br align="left"/>+updateTaskStatus(taskId, status): RedistributionTask<br align="left"/>+getTaskDetail(id) / getTasks(status)<br align="left"/></td></tr></table>>];
"RedistributionRecommendation" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity&raquo;</i></font><br/><b>RedistributionRecommendation</b></td></tr><tr><td align="left" balign="left">-source: M1_ALERT | M8_SIMULATION<br align="left"/>-externalRef, sourceHubId, destinationHubId<br align="left"/>-amount, taskCount: int<br align="left"/>-status: RecommendationStatus<br align="left"/>-reason, note, resolvedBy, createdAt, resolvedAt<br align="left"/></td></tr></table>>];
"RedistributionTask" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#4a6fa5"><tr><td bgcolor="#eef2fb" align="center"><font point-size="10"><i>&laquo;entity, redistribution_task&raquo;</i></font><br/><b>RedistributionTask</b></td></tr><tr><td align="left" balign="left">-vehicleId, sourceHubId, destinationHubId<br align="left"/>-status: RedistributionTaskStatus<br align="left"/>-recommendationId: String<br align="left"/>-createdAt, updatedAt<br align="left"/></td></tr></table>>];
"RedistributionRecommendations" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;interface, shared contract (for M8)&raquo;</i></font><br/><b>RedistributionRecommendations</b></td></tr><tr><td align="left" balign="left">+propose(...): String<br align="left"/>+approve(id, by): ApprovalResult<br align="left"/></td></tr></table>>];
"VehicleClient / HubClient" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;interfaces (JdbcFleetClient, ParkingHubClient)&raquo;</i></font><br/><b>VehicleClient / HubClient</b></td></tr><tr><td align="left" balign="left">+checkVehicle(id) / availableVehiclesAt(hub)<br align="left"/>+availableCountPerHub()<br align="left"/>+checkDestinationCapacity(hub)<br align="left"/></td></tr></table>>];
"ParkingDock" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#3a7d44"><tr><td bgcolor="#e6f4ea" align="center"><font point-size="10"><i>&laquo;shared contract (owner M4)&raquo;</i></font><br/><b>ParkingDock</b></td></tr><tr><td align="left" balign="left">+dock / undock<br align="left"/></td></tr></table>>];
"EventPublisher" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#888888"><tr><td bgcolor="#f2f2f2" align="center"><font point-size="10"><i>&laquo;shared&raquo;</i></font><br/><b>EventPublisher</b></td></tr><tr><td align="left" balign="left">DispatchStarted / Completed / Failed<br align="left"/>RecommendationApproved<br align="left"/></td></tr></table>>];
"RedistributionController" -> "RedistributionService" [arrowhead=vee, xlabel="" ];
"RecommendationController" -> "RecommendationService" [arrowhead=vee, xlabel="" ];
"RedistributionEventHandler" -> "RecommendationService" [arrowhead=vee, xlabel="proposeForAlert" ];
"RecommendationService" -> "RedistributionRecommendations" [style=dashed, arrowhead=onormal, xlabel="" ];
"RecommendationService" -> "RedistributionService" [arrowhead=vee, xlabel="one task per vehicle" ];
"RecommendationService" -> "RedistributionRecommendation" [arrowhead=vee, xlabel="" ];
"RecommendationService" -> "VehicleClient / HubClient" [arrowhead=vee, xlabel="" ];
"RedistributionService" -> "VehicleClient / HubClient" [arrowhead=vee, xlabel="" ];
"RedistributionService" -> "RedistributionTask" [arrowhead=vee, xlabel="" ];
"RedistributionService" -> "ParkingDock" [arrowhead=vee, xlabel="" ];
"RedistributionService" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="" ];
"RecommendationService" -> "EventPublisher" [style=dashed, arrowhead=vee, xlabel="" ];
"RedistributionTask" -> "RedistributionRecommendation" [arrowhead=vee, xlabel="0..* → 0..1" ];
}